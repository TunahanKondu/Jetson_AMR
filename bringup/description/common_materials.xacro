<?xml version="1.0" ?>
<robot  xmlns:xacro="http://ros.org/wiki/xacro">

<material name="jet_black">
  <color rgba="0.05 0.05 0.05 1"/>
</material>

<material name="pearl_white">
  <color rgba="0.95 0.95 0.95 1"/>
</material>

<material name="midnight_blue">
  <color rgba="0.1 0.1 0.3 1"/>
</material>

<material name="metallic_silver">
  <color rgba="0.7 0.7 0.75 1"/>
</material>

<material name="carbon_grey">
  <color rgba="0.3 0.3 0.3 1"/>
</material>

<material name="racing_red">
  <color rgba="0.7 0.0 0.0 1"/>
</material>

<material name="sky_blue">
  <color rgba="0.4 0.6 0.9 1"/>
</material>

<material name="sunset_orange">
  <color rgba="1.0 0.4 0.0 1"/>
</material>

<material name="forest_green">
  <color rgba="0.1 0.4 0.1 1"/>
</material>

<material name="champagne_gold">
  <color rgba="0.9 0.8 0.6 1"/>
</material>

<material name="steel_blue">
  <color rgba="0.4 0.5 0.6 1"/>
</material>

<material name="lava_red">
  <color rgba="0.6 0.1 0.1 1"/>
</material>

<material name="desert_sand">
  <color rgba="0.76 0.7 0.5 1"/>
</material>

<material name="lime_green">
  <color rgba="0.5 0.8 0.2 1"/>
</material>

<material name="turquoise">
  <color rgba="0.25 0.88 0.82 1"/>
</material>

<material name="graphite_black">
  <color rgba="0.15 0.15 0.15 1"/>
</material>

<material name="copper_bronze">
  <color rgba="0.72 0.45 0.2 1"/>
</material>

<material name="deep_purple">
  <color rgba="0.4 0.2 0.6 1"/>
</material>

<material name="frost_blue">
  <color rgba="0.75 0.85 0.95 1"/>
</material>

<material name="matte_green">
  <color rgba="0.2 0.4 0.2 1"/>
</material>

<material name="red">
  <color rgba="1 0 0 1"/>
</material>

<material name="green">
  <color rgba="0 1 0 1"/>
</material>

<material name="blue">
  <color rgba="0 0 1 1"/>
</material>

<material name="yellow">
  <color rgba="1 1 0 1"/>
</material>

<material name="cyan">
  <color rgba="0 1 1 1"/>
</material>

<material name="magenta">
  <color rgba="1 0 1 1"/>
</material>

<material name="white">
  <color rgba="1 1 1 1"/>
</material>

<material name="black">
  <color rgba="0 0 0 1"/>
</material>

<material name="gray">
  <color rgba="0.5 0.5 0.5 1"/>
</material>

<material name="orange">
  <color rgba="1 0.5 0 1"/>
</material>

    <xacro:macro name="box_inertia" params="m x y z o_xyz o_rpy">
        <inertial>
            <mass value="${m}" />
            <origin xyz="${o_xyz}" rpy="${o_rpy}" />
            <inertia ixx="${(m/12) * (y*y + z*z)}" ixy="0" ixz="0"
                     iyy="${(m/12) * (x*x + z*z)}" iyz="0"
                     izz="${(m/12) * (x*x + y*y)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r h o_xyz o_rpy">
        <inertial>
            <mass value="${m}"/>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <inertia ixx="${(1.0/12.0)*m*(3*r*r + h*h)}" ixy="0.0" ixz="0.0"
                    iyy="${(1.0/12.0)*m*(3*r*r + h*h)}" iyz="0.0"
                    izz="${0.5*m*r*r}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_inertia" params="m r o_xyz o_rpy">
        <inertial>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <mass value="${m}"/>
            <inertia ixx="${(2.0/5.0)*m*r*r}" ixy="0.0" ixz="0.0"
                        iyy="${(2.0/5.0)*m*r*r}" iyz="0.0"
                        izz="${(2.0/5.0)*m*r*r}"/>
        </inertial>
    </xacro:macro>

</robot>